# checkin-board settings (systemd EnvironmentFile). See README "Configuration".

# graywolf on this node. GW_USER is a graywolf login (not a Linux user).
# install.sh creates "checkin-board" with graywolf's CLI; to do it by hand:
#   sudo -u graywolf graywolf auth set-password --user checkin-board -config /var/lib/graywolf/graywolf.db
GW_BASE_URL=http://127.0.0.1:8080
GW_USER=checkin-board
# The password lives in its own file, readable only by the service user.
GW_PASSWORD_FILE=/etc/checkin-board/gw-password
GW_TIMEOUT=10s

CB_DB_PATH=/var/lib/checkin-board/checkin-board.db
# Address volunteers' phones connect to (http://<node>:8090/).
CB_LISTEN=:8090

# The local hook token: install.sh creates it and adds the line below.
# The node panel needs it; a graywolf webhook Action can use it too
# (docs/linkcheck-action.md). Without it, the hooks are off.
