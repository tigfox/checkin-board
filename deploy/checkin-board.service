[Unit]
Description=checkin-board race checkpoint reporting (talks to graywolf over its REST API)
Documentation=file:///usr/local/share/doc/checkin-board/operator-guide.md
# Start after graywolf when both run on this node. The app copes with
# graywolf being down or restarting, so this is ordering, not a hard
# dependency. No network-online wait: field nodes often have no uplink,
# and the app needs only loopback and its own listener.
After=graywolf.service
# A config error (e.g. a bad password file) stops retrying after 10 tries.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=/etc/checkin-board/checkin-board.env
ExecStart=/usr/local/bin/checkin-board
Restart=on-failure
RestartSec=5
# The app drains in-flight requests for up to 10 s on SIGTERM.
TimeoutStopSec=20

# Soft heap cap for the Pi Zero W (512 MB shared with graywolf).
Environment=GOMEMLIMIT=80MiB

User=checkin-board
Group=checkin-board

# Database, bib journal and reset backups live here.
StateDirectory=checkin-board
StateDirectoryMode=0750
WorkingDirectory=/var/lib/checkin-board

# Filesystem hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/checkin-board
UMask=0077

# Network
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Kernel hardening
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes

# Execution hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A syscall missing from the filter fails with EPERM instead of killing
# the service.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
